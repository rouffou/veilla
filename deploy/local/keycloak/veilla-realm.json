{
  "realm": "veilla",
  "displayName": "Veilla (développement local)",
  "enabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "nl",
    "de",
    "en"
  ],
  "defaultLocale": "fr",
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "cpmt"
      },
      {
        "name": "cpmt-dirigeant"
      },
      {
        "name": "infirmier"
      },
      {
