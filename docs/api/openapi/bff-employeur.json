            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "personneId",
          "posteId"
        ],
        "type": "object"
      },
      "LigneRisqueSaisie": {
        "properties": {
          "niveauExposition": {
            "type": [
              "null",
              "string"
            ]
