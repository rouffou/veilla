            "type": "string"
          },
          "debutAbsence": {
            "format": "date",
            "type": "string"
          },
          "personneId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "personneId",
          "dateReprise",
          "debutAbsence"
        ],
        "type": "object"
