{
  "components": {
    "schemas": {
      "AbsenceSaisieDto": {
        "properties": {
          "dateRendezVous": {
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "dateRendezVous"
        ],
        "type": "object"
      },
      "AnnulationDto": {
        "properties": {
          "date": {
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "date"
        ],
        "type": "object"
      },
      "ConclusionEvaluation": {
        "enum": [
          "TravailAdapteOuAutrePossible",
          "AucunTravailEnvisageable"
        ]
      },
      "DemanderTrajet": {
        "properties": {
          "dateDemande": {
            "format": "date",
            "type": "string"
          },
          "incapaciteId": {
            "format": "uuid",
            "type": "string"
          },
          "initiateur": {
            "$ref": "#/components/schemas/InitiateurTrajet"
          }
        },
        "required": [
          "incapaciteId",
          "initiateur",
          "dateDemande"
        ],
        "type": "object"
      },
      "DestinataireEHealth": {
        "enum": [
          "MedecinTraitant",
          "MedecinConseil",
          "CoordinateurRetourAuTravail"
        ]
      },
      "EffectifDto": {
        "properties": {
          "effectif": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "effectif"
        ],
        "type": "object"
      },
      "EstimationSaisieDto": {
        "properties": {
          "commentaire": {
            "type": [
              "null",
              "string"
            ]
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "methode": {
            "type": "string"
          },
          "resultat": {
            "$ref": "#/components/schemas/ResultatEstimation"
          }
        },
        "required": [
          "date",
          "resultat",
          "methode",
          "commentaire"
        ],
        "type": "object"
      },
      "EvaluationDto": {
        "properties": {
          "date": {
            "format": "date",
            "type": "string"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "date",
          "note"
        ],
        "type": "object"
      },
      "FinIncapaciteDto": {
        "properties": {
          "dernierJour": {
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "dernierJour"
        ],
        "type": "object"
      },
      "FinTrajetDto": {
        "properties": {
          "date": {
            "format": "date",
            "type": "string"
          },
          "issue": {
            "$ref": "#/components/schemas/IssueTrajet"
          }
        },
        "required": [
          "date",
          "issue"
        ],
        "type": "object"
      },
      "FormulaireDto": {
        "properties": {
          "conclusion": {
            "$ref": "#/components/schemas/ConclusionEvaluation"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "documentId": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "date",
          "conclusion",
          "documentId"
        ],
        "type": "object"
      },
      "InformationDto": {
        "properties": {
          "date": {
            "format": "date",
            "type": "string"
          },
          "documentId": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "date",
          "documentId"
        ],
        "type": "object"
      },
      "InitiateurTrajet": {
        "enum": [
          "Travailleur",
          "MedecinTraitant",
          "MedecinConseil",
          "Employeur",
          "Cpmt"
        ]
      },
      "InvitationDto": {
        "properties": {
          "date": {
            "format": "date",
            "type": "string"
          },
          "documentId": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          },
          "recommandee": {
            "type": "boolean"
          }
        },
        "required": [
          "date",
          "recommandee",
          "documentId"
        ],
        "type": "object"
      },
      "IssueTrajet": {
        "enum": [
          "PlanAccepte",
          "PlanRefuse",
          "RapportMotive",
          "Annule"
        ]
      },
      "ObjetEchange": {
        "enum": [
