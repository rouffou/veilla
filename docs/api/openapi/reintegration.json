          "InformationTrajet",
          "DemandeInformation",
          "Reponse",
          "Autre"
        ]
      },
      "PreparerEchange": {
        "properties": {
          "accordTravailleur": {
            "type": "boolean"
          },
          "contenu": {
            "type": "string"
          },
          "destinataire": {
            "$ref": "#/components/schemas/DestinataireEHealth"
          },
          "incapaciteId": {
            "format": "uuid",
            "type": "string"
          },
          "objet": {
            "$ref": "#/components/schemas/ObjetEchange"
          },
          "referenceDestinataire": {
            "type": [
              "null",
              "string"
            ]
          },
          "trajetId": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "incapaciteId",
          "trajetId",
          "destinataire",
          "objet",
          "contenu",
          "referenceDestinataire",
          "accordTravailleur"
        ],
        "type": "object"
      },
      "ReponseEmployeur": {
        "enum": [
          "PlanReintegration",
          "RapportMotive"
        ]
      },
      "ReponseEmployeurDto": {
        "properties": {
          "date": {
            "format": "date",
            "type": "string"
          },
          "documentId": {
            "format": "uuid",
            "type": [
              "null",
              "string"
            ]
          },
          "reponse": {
            "$ref": "#/components/schemas/ReponseEmployeur"
          }
        },
        "required": [
          "reponse",
          "date",
          "documentId"
        ],
        "type": "object"
      },
      "ReponseTravailleur": {
        "enum": [
          "Acceptation",
          "Refus"
        ]
      },
      "ReponseTravailleurDto": {
        "properties": {
          "date": {
            "format": "date",
            "type": "string"
          },
          "reponse": {
            "$ref": "#/components/schemas/ReponseTravailleur"
          }
        },
        "required": [
          "reponse",
          "date"
        ],
        "type": "object"
      },
      "ResultatEstimation": {
        "enum": [
          "RepriseTravailConvenu",
          "TrajetIndique",
          "RepriseNonEnvisageable",
          "EstimationImpossible"
        ]
      },
      "SaisirIncapacite": {
        "properties": {
          "affilieId": {
            "format": "uuid",
            "type": "string"
          },
          "dateDebut": {
            "format": "date",
            "type": "string"
          },
          "dateFinPrevue": {
            "format": "date",
            "type": [
              "null",
              "string"
            ]
          },
          "personneId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "personneId",
          "affilieId",
          "dateDebut",
          "dateFinPrevue"
        ],
        "type": "object"
      },
      "StatutEcheance": {
        "enum": [
          "AVenir",
          "Proche",
          "Depassee",
          "Respectee",
          null
        ]
      }
