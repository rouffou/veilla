{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": "sepp-api"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ServiceBus": {
    "SubscriptionName": "reintegration"
  },
  "Reintegration": {
    // Valeurs légales par défaut, tant que Référentiels n'a pas publié REINTEGRATION.* (ARC-21) : identiques au catalogue
    // initial de Référentiels et au §2.1 du cahier des charges (réforme 2026). À valider par le département juridique.
    "DelaisParDefaut": {
      "InformationTravailleurSemaines": 4,
      "EstimationPotentielSemaines": 8,
      "TrajetObligatoireMois": 6,
      "SeuilTravailleurs": 20,
      "AbsencesMedecinConseil": 2,
      "InvitationJoursCalendrier": 49,
      "ReponsePlanJoursCalendrier": 14
    },
    // Réglages d'organisation du suivi, pas des valeurs légales : à valider.
    "Suivi": {
      // SAN-65 : alerte N jours ouvrables avant chaque échéance (0 = désactivée).
      "AlerteAvantEcheanceJoursOuvrables": 5,
      // Délai de l'employeur pour le plan ou le rapport motivé : non fixé par le cahier, non suivi tant qu'il n'est pas validé.
      "DelaiPlanEmployeurJoursCalendrier": null,
      // SAN-64 : tentatives d'envoi eHealth avant abandon (relance manuelle ensuite).
      "TentativesEnvoiMaximum": 5
    },
    "Traitement": {
      "Actif": true,
      "Intervalle": "00:01:00"
    },
    "Adaptateurs": {
      // SAN-64 : Simulateur | Reel (squelette INT-04, voir le README du service).
      "EHealth": "Simulateur"
    }
  }
}
